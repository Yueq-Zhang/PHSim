{
    "max_batch_size": 2,
    "max_active_reqs": 2,
    "batch_scheduler": "continuous",
    "max_prefill_batch_tokens": 8,
    "max_seq_len": 16,
    "kv_cache_entry_size": 32,

    "allocation_scheme": "DASH",
    "virtual_mem_hash_enable": false,
    "dram_data_container_enable": false,

    "test_single_op": false,
    "test_single_op_name": "add",
    "test_multi_layer": false,
    "test_multi_layer_name": "prefill",

    "accelerate_ctrl": false,
    "accelerate_method": "Loop_wise",
    "accelerate_sample_ratio": 1.0,
    "attention_command_warmup_weight": 0.0,
    "softmax_warmup_rounds": 1,
    "softmax_sample_rounds": 1,
    "compile_time_tile_pruning": false,
    "decode_pruning_enabled": false,
    "decode_pruning_iterations": 1,
    "decode_pruning_sample_iterations": 1,

    "dram_trace_simulation_mode": false,

    "gen_request": false,
    "gen_request_count": 0,
    "gen_request_input_size": 0,
    "gen_request_output_size": 0,
    "output_token_iteration_enable": true,
    "gen_random_request": false,
    "request_interval": 1
}
