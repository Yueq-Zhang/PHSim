* text=auto eol=lf

# Source and configuration files are always UTF-8 text with LF line endings.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf
*.trace text eol=lf
*.py text eol=lf
*.pl text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Do not perform text conversion on binary artifacts.
*.a binary
*.dll binary
*.exe binary
*.gz binary
*.jpg binary
*.jpeg binary
*.lib binary
*.o binary
*.obj binary
*.pdf binary
*.png binary
*.pdb binary
*.so binary
*.svg binary
*.tar binary
*.tgz binary
*.zip binary
