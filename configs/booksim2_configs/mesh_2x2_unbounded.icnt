; Four-node 2x2 mesh with unbounded PHSim adapter buffers.
[booksim]
topology = mesh
k = 2
n = 2
routing_function = dim_order

subnets = 1
classes = 1
router = iq
num_vcs = 16
vc_buf_size = 8
flit_size = 16

routing_delay = 1
vc_alloc_delay = 1
sw_alloc_delay = 1
st_final_delay = 1
credit_delay = 1
use_noc_latency = 0

read_request_begin_vc = 0
read_request_end_vc = 3
write_request_begin_vc = 4
write_request_end_vc = 7
read_reply_begin_vc = 8
read_reply_end_vc = 11
write_reply_begin_vc = 12
write_reply_end_vc = 15
